---
layout: base.njk
title: Papers
permalink: /papers/
pageDescription: "Downloadable papers by George di Giovanni on Hegel, Kant, Fichte, Jacobi and Spinoza in German Idealism."
---
<div class="wrap page-header">
  <h1>Papers</h1>
  <p>Several of these are pre-publication texts. They are communicated for personal
  study and research only, and are not to be cited or reproduced in any way without
  permission.</p>
</div>

<div class="wrap section" style="border-top:1px solid var(--rule)">
  {% for group in papers | byDecade %}
  <section class="year-group">
    <h2 class="year-group__label">{{ group.label }}</h2>
    <ul class="pub-list">
      {% for p in group.items %}
      <li>
        <h3 class="pub__title">{{ p.title }}</h3>
        <p class="pub__meta"><strong style="color:var(--ink)">{{ p.year }}</strong> · {{ p.venue | safe }}</p>
        {% if p.pdf or p.doi %}
        <p class="pub__actions">
          {% if p.pdf %}<a class="filelink" href="/assets/pdf/{{ p.pdf }}">Read</a>{% endif %}
          {% if p.doi %}<a href="https://doi.org/{{ p.doi }}">doi:{{ p.doi }}</a>{% endif %}
        </p>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}
</div>
