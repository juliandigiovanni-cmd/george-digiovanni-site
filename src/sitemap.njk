---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{#- Written out rather than pulled from a plugin: this site has six pages, and a
    dependency to list six URLs is more to maintain than the loop below.

    collections.all covers every template that is not excluded. /research/ sets
    eleventyExcludeFromCollections itself, which is right -- it is a redirect to
    /papers/, and a sitemap should name the destination, not the signpost. -#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for page in collections.all %}
  <url>
    <loc>{{ site.url }}{{ page.url }}</loc>
    <lastmod>{{ page.date.toISOString() }}</lastmod>
  </url>
{%- endfor %}
</urlset>
